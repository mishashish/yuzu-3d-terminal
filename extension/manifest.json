{
  "manifest_version": 3,
  "name": "$YUZU — 3D Companion, Crypto Watchlist & Token Scanner",
  "version": "2.5.0",
  "description": "Interactive 3D Yuzu companion with custom crypto search & watchlist, Solana DEX/RugCheck scanner, focus timer, and trading tools.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "https://yuzuha-simulator.vercel.app/*",
    "https://www.okx.com/*",
    "https://api.binance.com/*",
    "https://api.coingecko.com/*",
    "https://api.dexscreener.com/*",
    "https://api.rugcheck.xyz/*",
    "https://api.alternative.me/*",
    "https://solana-rpc.publicnode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "$YUZU Terminal",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}