{
  "manifest_version": 3,
  "name": "$YUZU Crypto Companion — Live Pump & Dump Radar",
  "version": "1.1.0",
  "description": "Yuzu live inside your browser: resilient 24h crypto pump & dump radar (SOL, BTC, ETH, WIF, BONK, PEPE, JUP), voice briefs, alerts & draggable widget.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://www.okx.com/*",
    "https://api.binance.com/*",
    "https://api.coingecko.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "$YUZU Crypto Radar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
