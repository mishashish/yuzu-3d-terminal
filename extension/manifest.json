{
  "manifest_version": 3,
  "name": "$YUZU Crypto Companion — Live Pump & Dump Alerts",
  "version": "1.0.1",
  "description": "Yuzu live inside your browser: 24h crypto pump & dump radar for SOL, BTC, ETH, WIF, BONK, PEPE, JUP with voice briefs.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://api.binance.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "$YUZU Crypto Radar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
